<Window
    x:Class="NotchFlow.App.Features.Notch.NotchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">

        <!-- A ilha fica encostada no topo e centralizada. A janela em volta é recortada
             por SetWindowRgn, então nada aqui fora recebe clique. -->
        <Border
            x:Name="Island"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Background="#FF000000"
            CornerRadius="0,0,9,9">

            <Grid>

                <!-- Estado recolhido -->
                <Grid x:Name="CollapsedContent" Padding="7,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="CollapsedArtwork"
                        Grid.Column="0"
                        Width="18"
                        Height="18"
                        CornerRadius="4"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <Border.Background>
                            <ImageBrush x:Name="CollapsedArtworkBrush" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>

                    <!-- Indicador neutro quando não há capa ou quando a ilha está em modo tira. -->
                    <Border
                        x:Name="CollapsedIndicator"
                        Grid.Column="1"
                        Width="26"
                        Height="2.5"
                        CornerRadius="1.25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#9E9E9E" />

                    <FontIcon
                        x:Name="CollapsedStatusIcon"
                        Grid.Column="2"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="10"
                        Glyph="&#xE768;"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </Grid>

                <!-- Estado expandido -->
                <Grid
                    x:Name="ExpandedContent"
                    Opacity="0"
                    Visibility="Collapsed"
                    Padding="12,36,12,9">

                    <!-- Sem mídia -->
                    <StackPanel
                        x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="22"
                            Glyph="&#xE8D6;"
                            Foreground="#8A8A8A" />
                        <TextBlock
                            Text="Nada tocando"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="White"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Abra o Spotify, o Apple Music ou um site com áudio ou vídeo."
                            FontSize="9.5"
                            Foreground="#8A8A8A"
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            MaxWidth="230" />
                    </StackPanel>

                    <!-- Player -->
                    <Grid x:Name="PlayerState" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Capa e identificação -->
                        <Grid Grid.Row="0" ColumnSpacing="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="58" Height="58">
                                <Border x:Name="ArtworkFallback" CornerRadius="9" Background="#1F1F1F">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="20"
                                        Glyph="&#xE8D6;"
                                        Foreground="#FFFFFF" />
                                </Border>
                                <Border x:Name="ArtworkImage" CornerRadius="9" Visibility="Collapsed">
                                    <Border.Background>
                                        <ImageBrush x:Name="ArtworkBrush" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <FontIcon
                                        x:Name="SourceIcon"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="8"
                                        Glyph="&#xE8D6;"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        x:Name="SourceLabel"
                                        FontSize="8.5"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="TitleText"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="1" />
                                <TextBlock
                                    x:Name="SubtitleText"
                                    FontSize="10"
                                    Foreground="#9A9A9A"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="1" />
                            </StackPanel>
                        </Grid>

                        <!-- Progresso -->
                        <Grid Grid.Row="1" Margin="0,9,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Barra própria em vez de Slider: o controle padrão traz um
                                 polegar grande e um traço grosso que não combinam com a ilha.
                                 A área de toque é maior que o traço visível, como no original. -->
                            <Grid
                                x:Name="ProgressTrack"
                                Grid.Row="0"
                                Height="13"
                                Background="Transparent">
                                <Border
                                    Height="3"
                                    CornerRadius="1.5"
                                    Background="#24FFFFFF"
                                    VerticalAlignment="Center" />
                                <Border
                                    x:Name="ProgressFill"
                                    Height="3"
                                    Width="0"
                                    CornerRadius="1.5"
                                    Background="#D9FFFFFF"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center" />
                                <Ellipse
                                    x:Name="ProgressThumb"
                                    Width="7"
                                    Height="7"
                                    Fill="White"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <TextBlock
                                    x:Name="PositionText"
                                    FontSize="8.5"
                                    Foreground="#9A9A9A"
                                    HorizontalAlignment="Left"
                                    Text="0:00" />
                                <TextBlock
                                    x:Name="DurationText"
                                    FontSize="8.5"
                                    Foreground="#9A9A9A"
                                    HorizontalAlignment="Right"
                                    Text="0:00" />
                            </Grid>
                        </Grid>

                        <!-- Controles -->
                        <StackPanel
                            Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8">
                            <!-- E7A7 desenha a seta curvando para a esquerda e E7A6 para a
                                 direita, ao contrário do que os nomes Undo e Redo sugerem. -->
                            <Button
                                x:Name="BackFifteenButton"
                                Style="{StaticResource MediaButtonStyle}"
                                AutomationProperties.Name="Voltar 15 segundos"
                                ToolTipService.ToolTip="Voltar 15 segundos">
                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE7A7;" />
                            </Button>
                            <Button
                                x:Name="PreviousButton"
                                Style="{StaticResource MediaButtonStyle}"
                                AutomationProperties.Name="Faixa anterior"
                                ToolTipService.ToolTip="Faixa anterior">
                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE892;" />
                            </Button>
                            <Button
                                x:Name="PlayPauseButton"
                                Style="{StaticResource ProminentMediaButtonStyle}"
                                AutomationProperties.Name="Play ou pause"
                                ToolTipService.ToolTip="Play ou pause">
                                <FontIcon
                                    x:Name="PlayPauseIcon"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="14"
                                    Glyph="&#xE768;"
                                    Foreground="Black" />
                            </Button>
                            <Button
                                x:Name="NextButton"
                                Style="{StaticResource MediaButtonStyle}"
                                AutomationProperties.Name="Próxima faixa"
                                ToolTipService.ToolTip="Próxima faixa">
                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE893;" />
                            </Button>
                            <Button
                                x:Name="ForwardFifteenButton"
                                Style="{StaticResource MediaButtonStyle}"
                                AutomationProperties.Name="Avançar 15 segundos"
                                ToolTipService.ToolTip="Avançar 15 segundos">
                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE7A6;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Ações da ilha -->
                    <StackPanel
                        x:Name="IslandActions"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-29,0,0"
                        Spacing="5">
                        <Button x:Name="CollapseButton" Style="{StaticResource IslandActionStyle}" ToolTipService.ToolTip="Recolher painel">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="9" Glyph="&#xE70E;" />
                        </Button>
                        <Button x:Name="QuitButton" Style="{StaticResource IslandActionStyle}" ToolTipService.ToolTip="Encerrar NotchFlow">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="9" Glyph="&#xE7E8;" Foreground="#FF6B6B" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
